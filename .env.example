# Copy to .env and set absolute paths for docker mounts

# Fresh docker-only storage (recommended for first-time docker use)
PIPAL_DATA_DIR=/Users/you/.pipal-docker
PI_DATA_DIR=/Users/you/.pi-docker

# To reuse your existing host data instead, set:
# PIPAL_DATA_DIR=/Users/you/.pipal
# PI_DATA_DIR=/Users/you/.pi
